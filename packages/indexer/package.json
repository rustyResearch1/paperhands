{
  "name": "@paperhands/indexer",
  "version": "0.1.0",
  "type": "module",
  "description": "Activity-based pool discovery and live price/candle recorder for Robinhood Chain",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts"
  },
  "scripts": {
    "discover": "tsx src/main.ts discover",
    "watch": "tsx src/main.ts watch",
    "dev": "tsx src/main.ts all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@paperhands/chain": "workspace:*",
    "@paperhands/engine": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
